# =============================================================================
# ROTARI (RADAR TOKO) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and update with your Supabase project credentials.
# =============================================================================

# Supabase Project API URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Safe for browser / client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
